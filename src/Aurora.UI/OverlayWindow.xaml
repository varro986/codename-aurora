<Window x:Class="Aurora.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="420" Height="Auto"
        SizeToContent="Height"
        MouseMove="OnMouseMove"
        MouseLeave="OnMouseLeave">
    <Border x:Name="Container" CornerRadius="6" Padding="14,10">
        <StackPanel>
            <TextBlock x:Name="TranslationText"
                       FontSize="15" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="SourceLabel"
                       FontSize="10" Opacity="0.65" Margin="0,2,0,0" />
        </StackPanel>
    </Border>
</Window>
