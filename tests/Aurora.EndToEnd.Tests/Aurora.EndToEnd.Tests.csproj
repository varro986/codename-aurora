<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(WindowsMinimumVersion)</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <!-- One helper for both test projects that drive the sample targets. -->
    <Compile Include="..\Aurora.Windows.Tests\Support\SampleTarget.cs" Link="Support\SampleTarget.cs" />
    <Compile Include="..\Aurora.Windows.Tests\Support\Foreground.cs" Link="Support\Foreground.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Aurora.Core\Aurora.Core.csproj" />
  </ItemGroup>
</Project>
