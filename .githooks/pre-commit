#!/bin/sh
# pre-commit: blocks the commit if gitleaks finds secrets in the staged files.
# Enable once per clone: git config core.hooksPath .githooks
command -v gitleaks >/dev/null 2>&1 || { echo "gitleaks not found: https://github.com/gitleaks/gitleaks#installing"; exit 1; }
gitleaks git --pre-commit --staged --redact --no-banner -v || exit 1
exit 0
